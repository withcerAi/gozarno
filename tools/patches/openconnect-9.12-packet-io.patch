+/* Gozarno private ABI v1: no OS tunnel, routes or scripts. */
+int gozarno_openconnect_packet_io_v1(struct openconnect_info *,
+    int (*)(void *, unsigned char *, int), int (*)(void *, const unsigned char *, int), void *);
+int gozarno_openconnect_packet_io_v1(struct openconnect_info *vpninfo,
+    int (*read_packet)(void *, unsigned char *, int),
+    int (*write_packet)(void *, const unsigned char *, int), void *data)
+{
+    if (!read_packet || !write_packet || vpninfo->tun_fh || vpninfo->wintun) return -EINVAL;
+    vpninfo->gozarno_read_packet=read_packet;
+    vpninfo->gozarno_write_packet=write_packet;
+    vpninfo->gozarno_packet_data=data;
+    return 0;
+}
